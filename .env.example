# ---- Delivery: email (reuses the Gmail App Password pattern from sec-filings)
NOTIFY_TO_EMAIL=you@example.com
NOTIFY_FROM_EMAIL=you@example.com
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=you@example.com
# Gmail App Password: https://myaccount.google.com/apppasswords
NOTIFY_SMTP_PASS=

# ---- Delivery: phone push via ntfy.sh (free, no account)
# Pick an UNGUESSABLE topic — anyone who knows it can read your alerts.
# Install the ntfy app, subscribe to this topic, and you get instant push.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ---- Engine
POLL_SECONDS=60
# Evaluate alerts during pre-market and after-hours too (04:00-20:00 ET)
INCLUDE_EXTENDED_HOURS=true
# How long without a completed poll before /healthz reports the poller dead.
# Defaults to three poll intervals, minimum 180s.
#ENGINE_STALE_SECONDS=180

# ---- Web
PORT=8080
# Set to a long random string to require a login on the web UI.
# Leave blank for no auth (safe only when bound to localhost).
UI_PASSWORD=
# Failed logins allowed per client address before a lockout, and its length.
#LOGIN_MAX_ATTEMPTS=8
#LOGIN_LOCKOUT_SECONDS=300
# Signs session cookies. Generated and stored in DATA_DIR if left blank; set it
# explicitly if you run the web app on more than one host.
#SECRET_KEY=

# ---- Misc
# Check that a ticker resolves before saving an alert for it. Turn off if you
# want to add symbols while offline.
#VALIDATE_TICKERS=true
